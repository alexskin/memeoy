# Read-only RPC access - NOT a wallet, NOT a financial credential.
# Public endpoints get rate-limited fast under this load (pool-creation firehose
# + several follow-up calls per filtered pool). Get a free-tier key from
# Helius / Chainstack / Ankr / QuickNode / Triton and put the HTTPS + WSS
# URLs here. The provider is auto-detected from the URL's hostname
# (lib/config/env.ts) - no separate "which provider" setting needed.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Optional secondary RPC, used automatically as a per-call failover only
# when the primary throws a rate-limit-shaped error (lib/solana/connection.ts)
# - keeps a free-tier RPS cap on the primary from stalling the worker.
# Recommended pairing: Chainstack (25 RPS free) as primary + Ankr (30 RPS,
# 200M requests/month free) as fallback - different infra, real redundancy.
# Leave both unset to run single-provider.
# RPC_ENDPOINT_FALLBACK=
# RPC_WEBSOCKET_ENDPOINT_FALLBACK=

# Optional: override the auto-selected per-provider requests/second cap
# (defaults live in lib/solana/rpcRateLimiter.ts, already tuned below each
# provider's documented free-tier ceiling). Rarely needed.
# RPC_MAX_REQUESTS_PER_SECOND=
# RPC_FALLBACK_MAX_REQUESTS_PER_SECOND=

# Worker's local websocket server (dashboard connects here for live updates)
WORKER_WS_PORT=8787
# Same value, exposed to the browser bundle (Next.js only inlines NEXT_PUBLIC_* vars)
NEXT_PUBLIC_WORKER_WS_PORT=8787

# Optional: only used by lib/agent/llmTuner.ts to annotate/soften heuristic
# proposals in plain English. Leave unset and the tuning agent still runs
# fully on the deterministic heuristic baseline.
# ANTHROPIC_API_KEY=

# Optional: Discord webhook - posts a notification whenever the worker opens
# a simulated position. Leave unset to disable.
# DISCORD_WEBHOOK_URL=

# Only required if you switch StrategyConfig.tradingMode to "live" in the
# dashboard's Strategy tab - a real Solana wallet secret key (base58 string,
# or a JSON byte array like "[12,34,...]"), used ONLY to sign real swaps on
# Raydium. Never logged, never sent anywhere but the local signing call.
# See README.md's "Going live" section before setting this.
# WALLET_PRIVATE_KEY=

# Only needed if you're running the OPTIONAL public read-only dashboard on
# Vercel (see README.md's "Public read-only dashboard on Vercel" section).
# Set these here too (not just in Vercel) so your local worker's sync job
# mirrors data to Turso - the worker itself keeps using its local DB either
# way, this is a one-way push, never a dependency of the trading logic.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# NEXT_PUBLIC_READ_ONLY and NEXT_PUBLIC_DISABLE_WS are Vercel-project env
# vars for that same optional deployment, not local settings - don't set
# them here. See the README section above.
